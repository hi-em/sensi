# Upload set for `gcloud run deploy --source .` (Cloud Build). Explicit so the
# build context is deterministic instead of derived from .gitignore.
.git
.gitignore
.env
.env.*
!.env.example
**/node_modules
**/dist
**/__pycache__
**/*.pyc
**/.venv
web/.env.local
# Personal personas — the image ships the curated demo profile only.
personas/persona.*.local.json
docs
final-sensi-concept
resulting_layout
**/*.mp4
