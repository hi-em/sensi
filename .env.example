## Sensi environment
## Copy this file to `.env` at the repository root and fill in the provider you use.
## `.env` is git-ignored. Never commit real keys.

## ── LLM provider ─────────────────────────────────────────────────────────────
## One of: "google" | "openai" | "cloudflare" | "local"
## Every provider is reached through one OpenAI-compatible client, so you only
## need the keys for the provider you actually select.
##   "local"       → OpenAI-compatible local server (LM Studio, Ollama)
##   "google"      → Google Gemini
##   "cloudflare"  → Cloudflare Workers AI (free tier, no credit card)
##   "openai"      → OpenAI API
##   "anthropic"   → Anthropic API (not currently supported: the JSON response
##                   handling in this codebase does not match its format)

LLM_PROVIDER = "google"

# Google
GOOGLE_API_KEY = "your_google_api_key"
GOOGLE_MODEL   = "gemini-2.5-flash-lite"
# Optional: a SEPARATE key for image generation, so images can bill on a capped
# paid project while chat stays on a free-tier (un-billable) key.
# GOOGLE_IMAGE_API_KEY = "your_image_project_api_key"

# OpenAI
OPENAI_API_KEY = "your_openai_api_key"
OPENAI_MODEL   = "gpt-5-nano"

# Cloudflare Workers AI
CF_ACCOUNT_ID = "your_cloudflare_account_id"
CF_API_TOKEN  = "your_cloudflare_api_token"
CF_MODEL      = "@cf/qwen/qwen3-30b-a3b-fp8"

# Local (OpenAI-compatible endpoint)
LOCAL_LLM_ENDPOINT = "http://localhost:1234/v1/"

# Anthropic
ANTHROPIC_API_KEY = "your_anthropic_api_key"
ANTHROPIC_MODEL   = "claude-haiku-4-5"

## ── Per-node model tiers (optional) ──────────────────────────────────────────
## A small model for routing and short text, a larger one for user-facing prose.
## Both fall back to the base model above when unset. The same pattern works for
## any provider: OPENAI_MODEL_FAST, CF_MODEL_SMART, and so on.

GOOGLE_MODEL_FAST  = "gemini-2.5-flash-lite"
GOOGLE_MODEL_SMART = "gemini-2.5-flash"

## ── Image generation (optional) ──────────────────────────────────────────────
## Powers the per-room "feeling" renders in the Report and Vision screens.
## Falls back to LLM_PROVIDER when unset.

IMAGE_PROVIDER       = "google"
GOOGLE_IMAGE_MODEL   = "gemini-2.5-flash-image"
OPENAI_IMAGE_MODEL   = "gpt-image-1"
OPENAI_IMAGE_QUALITY = "medium"          # low | medium | high

## Unsplash, used by the inspire pipeline for reference imagery. Optional.
UNSPLASH_ACCESS_KEY = ""

## ── Runtime ──────────────────────────────────────────────────────────────────

REQUEST_TIMEOUT_SECONDS = "30"
DEBUG_GRAPH             = "false"   # "true" prints StateGraph step traces
MAX_ITERATIONS          = "100"     # max StateGraph iterations

# Public-demo hardening (leave off locally). Enables per-visitor + global rate
# limits sized to free LLM quotas, and makes the shared persona.json read-only
# so visitors can't overwrite each other. See python/api/rate_limit.py.
DEMO_MODE               = "false"

## ── Benchmark scripts only (optional) ────────────────────────────────────────
## Read by bench_nodes.py, bench_quality.py and imaging/benchmark.py. Not needed
## to run the app.

# BENCH_NODES            = "1"
# BENCH_QUALITY          = "1"
# BENCH_IMAGE_PROVIDERS  = "google,openai"
